{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/opportunity.schema.json",
  "title": "Student opportunity",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {"required": ["eligibility_geographies"]},
    {"required": ["geographies"]}
  ],
  "required": [
    "id", "name", "organization", "categories", "official_url",
    "description", "delivery", "student_levels", "fields",
    "tags", "benefits", "schedule", "lifecycle", "last_verified",
    "verification_sources"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 100},
    "name": {"type": "string", "minLength": 2, "maxLength": 160},
    "organization": {"type": "string", "minLength": 2, "maxLength": 160},
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "official_url": {"$ref": "#/$defs/httpUrl"},
    "application_url": {"oneOf": [{"$ref": "#/$defs/httpUrl"}, {"type": "null"}]},
    "application_method": {"type": "string"},
    "application_fee": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "amount", "currency", "notes"],
      "properties": {
        "required": {"type": ["boolean", "null"]},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "notes": {"type": ["string", "null"], "maxLength": 500}
      }
    },
    "description": {"type": "string", "minLength": 30, "maxLength": 1200},
    "geographies": {
      "deprecated": true,
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["scope", "values"],
        "properties": {
          "scope": {"type": "string"},
          "basis": {"type": "string"},
          "values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
        }
      }
    },
    "eligibility_geographies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["scope", "basis", "values"],
        "properties": {
          "scope": {"type": "string"},
          "basis": {"type": "string"},
          "values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
        }
      }
    },
    "locations": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/geography"}
    },
    "delivery": {"type": "string"},
    "student_levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "eligibility_summary": {"type": ["string", "null"], "maxLength": 1000},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "benefits": {
      "type": "object", "additionalProperties": false, "required": ["summary", "amount", "currency", "equity_required"],
      "properties": {
        "summary": {"type": ["string", "null"], "maxLength": 500},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "amount_type": {"type": ["string", "null"]},
        "amount_frequency": {"type": ["string", "null"]},
        "amount_qualifier": {"type": ["string", "null"]},
        "equity_required": {"type": ["boolean", "null"]}
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["type", "cycles", "typical_open_months", "typical_close_months"],
      "properties": {
        "type": {"type": "string"},
        "timezone": {"type": ["string", "null"], "maxLength": 80},
        "cycles": {"type": "array", "items": {"$ref": "#/$defs/cycle"}},
        "typical_open_months": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 12}},
        "typical_close_months": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 12}}
      }
    },
    "lifecycle": {"type": "string"},
    "lifecycle_note": {"type": ["string", "null"], "maxLength": 500},
    "discontinued_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "last_verified": {"$ref": "#/$defs/date"},
    "verification_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["url", "accessed_on", "kind"],
        "properties": {
          "url": {"$ref": "#/$defs/httpUrl"},
          "accessed_on": {"$ref": "#/$defs/date"},
          "kind": {"enum": ["official-program-page", "official-announcement", "official-social", "secondary-source"]}
        }
      }
    },
    "notes": {"type": ["string", "null"], "maxLength": 1000}
  },
  "$defs": {
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "httpUrl": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2000},
    "geography": {
      "type": "object", "additionalProperties": false, "required": ["scope", "values"],
      "properties": {
        "scope": {"type": "string"},
        "values": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
      }
    },
    "cycle": {
      "type": "object", "additionalProperties": false, "required": ["label", "opens_on", "deadline"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 80},
        "opens_on": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "deadline": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "deadline_time": {"type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}
      }
    }
  }
}
